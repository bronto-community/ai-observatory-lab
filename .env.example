# Bronto ingestion key: the workshop one from the card on your table, or your own (bronto.io/signup)
OTEL_EXPORTER_OTLP_HEADERS=x-bronto-api-key=PASTE-KEY-HERE
# Your name, lowercase, no spaces. This is how you find your own traces.
ATTENDEE=yourname
# Optional overrides
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS_REGION=us-west-2
# BRONTO_REGION=eu   (use `us` with a US Bronto account: OTEL_EXPORTER_OTLP_ENDPOINT=https://ingestion.us.bronto.io)
